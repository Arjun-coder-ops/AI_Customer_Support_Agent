# LLM API Keys (Set at least one or use MOCK_LLM=true)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Kaggle Credentials (optional, for automated downloading of twcs.csv)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key

# Mock LLM mode (set to true to test pipeline without API calls)
MOCK_LLM=false
